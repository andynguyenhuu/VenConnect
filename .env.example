# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REGION=AU # Default region (AU or VN)

# Auth0 Configuration
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.au.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_ISSUER_BASE_URL=https://your-tenant.au.auth0.com

# Replicate API
REPLICATE_API_TOKEN=your-replicate-api-token
REPLICATE_MODEL_VERSION=anthropic/claude-4-sonnet

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/venconnect

# Redis
REDIS_URL=redis://localhost:6379

# AWS Configuration
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=venconnect-uploads

# API Configuration
API_BASE_URL=http://localhost:8000
API_KEY=your-internal-api-key

# Feature Flags
ENABLE_FILE_UPLOAD=true
ENABLE_MULTI_REGION=true
MAX_FILE_SIZE_MB=10
MAX_CONTEXT_TOKENS=200000

# Monitoring
DATADOG_API_KEY=your-datadog-api-key
SENTRY_DSN=your-sentry-dsn

# Currency Exchange Rate (for display)
AUD_TO_VND_RATE=17150
